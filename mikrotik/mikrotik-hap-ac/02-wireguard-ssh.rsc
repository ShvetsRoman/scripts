# WireGuard VPN server for RouterOS 7, run AFTER 01-base-hap-ac.rsc
# Edit REMOTE_PEER_PUBLIC_KEY with public key from your CLIENT (never private key).
# WAN must be reachable (public IPv4 or upstream UDP port forward). DDNS does NOT bypass CGNAT.
:local peerPublicKey "REPLACE_WITH_CLIENT_PUBLIC_KEY"
:if ($peerPublicKey = "REPLACE_WITH_CLIENT_PUBLIC_KEY") do={ :error "Set client public key first" }
:if ([:len [/ip firewall filter find where comment="INPUT: Drop other"]] != 1) do={ :error "Base firewall INPUT end missing" }
:if ([:len [/ip firewall filter find where comment="FORWARD: Drop other"]] != 1) do={ :error "Base firewall FORWARD end missing" }
:if ([:len [/interface wireguard find where name="wg-remote"]] > 0) do={ :error "wg-remote already exists" }

# Public dynamic IP address gets MikroTik hostname (e.g. xxx.sn.mynetname.net).
/ip cloud set ddns-enabled=yes
/ip cloud force-update

# WireGuard private/public key pair generated by RouterOS on creation.
/interface wireguard add name=wg-remote listen-port=51820 mtu=1420 comment="Remote SSH VPN"
/ip address add address=10.77.0.1/24 interface=wg-remote comment="VPN gateway"
/interface wireguard peers add interface=wg-remote public-key=$peerPublicKey \
    allowed-address=10.77.0.2/32 comment="roman remote client"

# Allow only encrypted WireGuard UDP from WAN into the router.
/ip firewall filter add chain=input action=accept protocol=udp in-interface-list=WAN \
    dst-port=51820 place-before=[find where comment="INPUT: Drop other"] \
    comment="INPUT: WireGuard UDP 51820"

# Only allow SSH from WireGuard client to home server 192.168.88.7:2241.
/ip firewall filter add chain=forward action=accept connection-state=new \
    in-interface=wg-remote src-address=10.77.0.2 dst-address=192.168.88.7 \
    protocol=tcp dst-port=2241 place-before=[find where comment="FORWARD: Drop other"] \
    comment="FORWARD: WireGuard SSH to server-pc"

:put "WG interface public key (copy into client Peer.PublicKey):"
/interface wireguard print detail where name="wg-remote"
:put "DDNS hostname for client Endpoint:" 
/ip cloud print
:put "Client tunnel IP: 10.77.0.2/32; reachable server: 192.168.88.7:2241"
