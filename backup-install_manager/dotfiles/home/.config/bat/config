# ============================================================
# BAT CONFIGURATION
# ~/.config/bat/config
# ============================================================


# ============================================================
# КОЛЬОРОВА ТЕМА
# ============================================================

# Основна тема підсвічування синтаксису.
--theme="Nord"

# Колір визначається параметрами команди.
# Не задаємо --color=auto, оскільки Superfile використовує
# --force-colorization, який конфліктує з цим параметром.


# ============================================================
# ВІЗУАЛЬНЕ ОФОРМЛЕННЯ
# ============================================================

# grid     — рамка навколо виводу та роздільники;
# numbers  — нумерація рядків;
# changes  — індикатори Git-змін;
# header   — заголовок із назвою файлу.
--style="grid,numbers,changes,header"

# Автоматичне відображення декоративних елементів.
# --decorations=auto

# Курсив для синтаксичних елементів.
--italic-text=always

# Ширина символу табуляції.
--tabs=4


# ============================================================
# ПЕРЕНЕСЕННЯ РЯДКІВ
# ============================================================

# Автоматичне перенесення довгих рядків.
--wrap=auto


# ============================================================
# PAGER
# ============================================================

# Автоматичне використання Pager.
--paging=auto

# Less: збереження кольорів ANSI.
--pager="less -R"

