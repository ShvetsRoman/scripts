{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "command.palette.show": "ctrl+p"
  },
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": false,
    "volume": 0.3
  },
  "diffs": {},
  "mouse": true,
  "cursor": {
    "style": "block",
    "blinking": true
  }
}
