# ============================================================
# SETUP MANAGER V3.0 — GITIGNORE
# Зберігаємо вихідний код, конфіги й dotfiles у Git.
# Ігноруємо згенеровані дані та локальні секрети.
# ============================================================

# Тимчасові файли та діагностика

*.tmp
*.temp
*.bak
*.bak.*
*.swp
*.swo
*~
*.orig
*.rej
/debug.log

# Python / IDE / локальні інструменти
__pycache__/
.pytest_cache/
.idea/
.vscode/

# Секрети та локальні перевизначення
.env
.env.*
!.env.example
*.local.conf

# MikroTik: конфіги з паролями та бекапи не комітяться.
# config.rsc після заповнення містить adminPassword / wifiPassword /
# wgPeerKey у відкритому вигляді — зберігати лише локально.
mikrotik-manager/routers/*/config.rsc
mikrotik-manager-bash/profiles/*/.secrets
mikrotik-manager-bash/profiles/*/backups/
mikrotik/*.rsc
