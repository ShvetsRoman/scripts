*.tmp
*.temp
*.bak
*.bak.*
*.swp
*.swo
*~
*.orig
*.rej
/debug.log

# Python / IDE / локальні інструменти
__pycache__/
.pytest_cache/
.idea/
.vscode/

# Секрети та локальні перевизначення
.env
.env.*
!.env.example
*.local.conf
