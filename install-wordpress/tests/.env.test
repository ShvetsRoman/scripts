COMPOSE_PROJECT_NAME=wp-test-12345678
DEPLOY_MODE=lan
DOMAIN=wp.local
ACME_EMAIL=
APP_URL=http://wp.local
INSTALL_DIR=/tmp/wp-test
TRAEFIK_VERSION=3.7.13
NGINX_VERSION=1.29-alpine
WORDPRESS_VERSION=php8.3-fpm-alpine
MYSQL_VERSION=8.4.11
WPCLI_VERSION=cli-php8.3
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=testpassword123
MYSQL_ROOT_PASSWORD=testrootpassword123
WORDPRESS_DB_HOST=db:3306
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=testadminpassword123
WORDPRESS_ADMIN_EMAIL=admin@example.com
WORDPRESS_TITLE=My WordPress Site
MEMORY_LIMIT=512M
UPLOAD_MAX_FILESIZE=128M
POST_MAX_SIZE=128M
MAX_EXECUTION_TIME=300
MAX_INPUT_VARS=3000
BACKUP_RETENTION_DAYS=30
